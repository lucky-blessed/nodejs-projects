#!/usr/bin/env node

const fs = require("fs");
const path = require("path");
const readline = require("readline") // To build interactive mode cli

// Helper function for timestamps
function now(){
    return new Date().toISOString();
}

// Path to tasks.json
const dataFile = path.join(__dirname, "..", "data", "tasks.json");

// Ensure tasks.json exist
if (!fs.existsSync(dataFile)) {
    fs.mkdirSync(path.dirname(dataFile), { recursive: true });
    fs.writeFileSync(dataFile, JSON.stringify([]));
}

// Load tasks
function loadTasks() {
    const file = path.join(__dirname, "../data/tasks.json");

    if(!fs.existsSync(file)) {
        fs.writeFileSync(file, "[]", "utf8");
        return [];
    }

    const raw = fs.readFileSync(file, "utf8").trim();

    if (raw === "") {
        // empty file -> initialize
        return [];
    }

    try {
        const tasks = JSON.parse(raw);

        // Migrate: Completed -> Status
        tasks.forEach(task => {
            if (!task.status) {
                if (task.completed === true) {
                    task.status = "done";
                } else {
                    task.status = "todo";
                }
                delete task.completed;
            }
        });

        return tasks;
    } catch (e) {
        console.error("Error parsing tasks.json. Reseting file.");
        fs.writeFileSync(file, "[]", "utf8");
        return [];
    }
}

// Save task
function saveTasks(tasks) {
    fs.writeFileSync(dataFile, JSON.stringify(tasks, null, 2), "utf8");
}

// CLI args
const [,, command, ...args] = process.argv;

// If no command is provided, start interactive mode
if (!command) {
    startInteractiveMode();
    return;
}

// Interactive loop
function startInteractiveMode() {
    const rl = readline.createInterface({
        input: process.stdin,
        output: process.stdout,
        prompt: "Lucky-Task-Cli>> "
    });

    console.log("Task Tracker Interactive Mode");
    console.log('Type "help" to see available commands.\n');

    rl.prompt();

    rl.on("line", (input) => {
        const trimmed = input.trim();

        if (trimmed === "exit" || trimmed === "quit") {
            rl.close();
            return;
        }

        if (trimmed === "help") {
            printHelp();
            rl.prompt();
            return;
        }

        const [cmd, ...cmdArgs] = trimmed.split(" ");
        handleCommand(cmd, cmdArgs);

        rl.prompt();
    });

    rl.on("close", () => {
        console.log("\nGoodbye!");
        process.exit(0);
    });
}

// Help
function printHelp() {
    console.log(`
Available commands:
    add <description>
    list [done|in-progress|todo]
    done <task_id>
    progress <task_id>
    update <task_id> <new description>
    delete <task_id>
    help
    quit
        
        `);
}

// Task commands
function handleCommand(command, args) {
    switch (command) {
        case "add":
            const description = args.join(" ");
            if (!description) {
                console.log("Nope! Please provide a task description");
                process.exit(1);
            }
            const tasks = loadTasks();
            
            // Helper function to generate non breaking unique IDs
            function getNextId(tasks) {
                if (tasks.length === 0) return 1;
                return Math.max(...tasks.map(t => t.id)) + 1;
            }
            tasks.push({ 
                id: getNextId(tasks),
                description: description,
                status: "todo",
                createdAt: now(),
                updatedAt: now()
            });

            saveTasks(tasks);
            console.log(`Good! task added: "${description}"`);
            break;

        case "list": {
            const filter = args[0]; // done | in-progress | not done | undefined
            let tasks = loadTasks();

            if (tasks.length === 0) {
                console.log("No task found.");
                break;
            }

            if (filter) {
                switch (filter) {
                    case "done":
                        tasks = tasks.filter(t => t.status === "done");
                        break;

                    case "in-progress":
                    tasks = tasks.filter(t => t.status === "in-progress");
                    break;
                    
                    case "not-done":
                        tasks = tasks.filter(t => t.status !== "done");
                        break;

                    default:
                        console.log(`Unknown filter "${filter}"`);
                        process.exit(1);
                }
            }

            if (tasks.length === 0) {
                console.log("No matching tasks found.");
                break;
            }

            const statusMap = {
                "todo": "[ ]",
                "in-progress": "[\u007E]",
                "done": "[\u2713]"
            };

            console.log("Task List");
            tasks.forEach(t => {
                console.log(`${t.id}. ${statusMap[t.status]} ${t.description}`);
            });
            break;
        }

        case "done": {
            const taskId = parseInt(args[0]); 
            if (!taskId) {
                console.log("Please enter a valid task ID.");
                process.exit(1)
            }

            const doneTasks = loadTasks();
            const task = doneTasks.find(t => t.id === taskId);

            if (!task) {
                console.log("Task not found.");
                process.exit(1);
            }

            task.status = "done";
            task.updatedAt = now();

            saveTasks(doneTasks);
            console.log(`Task ${taskId} marked as completed.`);
            break;
        }

        case "update": {
            try {
                const taskId = parseInt(args[0]);
                const newDescription = args.slice(1).join(" ");

                if (!taskId) {
                    console.log("Please provide a valid task ID.");
                    process.exit(1);
                }

                if (!newDescription) {
                    console.log("Please provide a new task description.");
                    process.exit(1);
                }

                const tasks = loadTasks();
                const task = tasks.find(t => t.id === taskId);

                if (!task) {
                    console.log(`Task with ID ${taskId} not found.`);
                    process.exit(1);
                }

                task.description = newDescription;
                task.updatedAt = now();
                saveTasks(tasks);

                console.log(`Task ${taskId} updated successfully.`);
            } catch (err) {
                console.error("An error occurred while updating the task.");
                }
            break;
            }

        case "progress":{
            const taskId = parseInt(args[0]);

            if (!taskId) {
                console.log("Please enter a valid task ID.");
                process.exit(1);
            }

            const tasks = loadTasks();
            const task = tasks.find(t => t.id === taskId);

            if (!task) {
                console.log(`Task with ID ${taskId} not found.`);
                process.exit(1);
            }

            task.status = "in-progress";
            task.updatedAt = now();

            saveTasks(tasks);
            console.log(`Task ${taskId} marked as in progress.`);
            break;
        }

        case "delete": {
            try {
                const taskId = parseInt(args[0]);

                if (!taskId) {
                    console.log("Please provide a valid task ID.");
                    process.exit(1);
                }

                const tasks =loadTasks();
                const filteredTasks = tasks.filter(t => t.id !== taskId);

                if (filteredTasks.length === tasks.length) {
                    console.log(`Task with ID ${taskId} not found.`);
                    process.exit(1);
                }
                    
                saveTasks(filteredTasks);
                console.log(`Task ${taskId} deleted successfully.`);
            } catch (err) {
                    console.error("An error occored while deleting the task.");
                }
            break;
            }

        case "show": {
            const taskId = parseInt(args[0]);

            if (!taskId) {
                console.log("Please provide a valid task ID.");
                process.exit(1);
            }

            const tasks = loadTasks();
            const task = tasks.find(t => t.id === taskId);

            if (!task) {
                console.log(`Task with ID ${taskId} not found.`);
                process.exit(1);
            }

            function formatDate(iso) {
                return new Date(iso).toLocaleString();
            }

            console.log(`
                Task Details
                .....................
                ID: ${task.id}
                Description: ${task.description}
                Status: ${task.status}
                Created At: ${formatDate(task.createdAt)}
                Updated At: ${formatDate(task.updatedAt)}
                `.trim());

            break;
        }

        default:
            console.log(`
                Available command:
                task-cli add <Task description>
                task-cli list
                task-cli done <task_id>
                task-cli update <task_id> <New task description>
                task-cli show <task_id>
                task-cli delete <task_id>
        `);
    }
}

handleCommand(command, args);